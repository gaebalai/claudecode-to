# blog-url-to-shortform skill — environment variables
# 사용법: 이 파일을 `.env`로 복사한 뒤 각 값을 채우세요.
#   cp .env.example .env

# ─── ElevenLabs (Phase 2 TTS) ───────────────────────────────────────────────
# API 키: https://elevenlabs.io/app/settings/api-keys 에서 발급
ELEVENLABS_API_KEY=

# 한국어 voice ID 2개 (Voice Library에서 클립 들어보고 ID 복사)
# Rosa Oh = 30대 여성, 리드 / Joon Park = 20대 후반 남성, 리액션
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# (선택) TTS 모델. 기본 eleven_multilingual_v2 (한국어 지원). 비우면 기본값 사용.
ELEVENLABS_MODEL=eleven_multilingual_v2

# ─── OpenAI (Phase 2 GPT Image 2) ───────────────────────────────────────────
# gpt-image-2 사용 가능한 Tier 키 필요
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (선택) 이미지 모델·크기 오버라이드
# 모델 ID가 OpenAI 측 변경에 따라 안 맞으면 여기서 바꿔 끼우면 됨
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
